+    review: null,
+    submittedAt: new Date().toISOString(),
+  };
+  if (repair) {
+    const actual = spawnSync(
+      process.execPath,
+      [
+        '-e',
+        "require('node:fs').appendFileSync('prior-check-count', 'executed\\n'); process.exit(0)",
