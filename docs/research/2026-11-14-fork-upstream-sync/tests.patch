+  expect(decision).toMatchObject({ allowed: true, phase: 'verify' });
+  await fs.writeFile(path.join(root, 'worker.py'), after);
+  await cli('next', 'demo');
+  const afterEdit = await inspect();
+  expect(afterEdit.state.phase).toBe('verify');
+  if (generated && !alias) {
