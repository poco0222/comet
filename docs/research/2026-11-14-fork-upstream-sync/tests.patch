+    });
+    await runtime.recordOutcome({
+      runId: 'demo',
+      outcome: {
+        actionId: verifier.id,
+        attempt: verifier.attempt,
+        inputHash: verifier.inputHash,
+        claimToken: verifierToken,
+        outcomeId: randomUUID(),
+        status: 'succeeded',
+        output: {
